{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallflow",
  "version": "0.1.2",
  "identifier": "dev.wallflow.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Wallflow",
        "width": 1080,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxQ0U0RTdGMDg2MkY1OTQKUldTVTlXSUlmMDdPd1IxVmp2TVMzUWo5dlUxWHFWbnBQRFYxa2RqWThidjM2LzJ1RnhlU0J1bVMK",
      "endpoints": ["https://github.com/takdiras/wallflow/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
